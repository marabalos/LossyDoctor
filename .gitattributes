# Canonical text representation and checkout format
* text=auto eol=lf

# Windows launcher: LF is intentional and supported on Windows 10+
*.bat text eol=lf

# Executables and binary/audio fixtures must never be normalized
*.exe binary
*.bin binary
*.aac binary
*.mp2 binary
*.mp3 binary
*.mpa binary
*.m4a binary
*.mp4 binary
*.ogg binary
*.opus binary
*.wma binary
*.flac binary
*.zip binary

# Exclude development-only material from source archives
/.codex export-ignore
/.codex/** export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/TESTING.md export-ignore
/release_packaging.py export-ignore
/tests export-ignore
/tests/** export-ignore
/samples export-ignore
/samples/** export-ignore
